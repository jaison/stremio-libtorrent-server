# Recommended configuration for the current library deployment.
# Copy to .env and adjust values for your server.

# Maximum size of the evictable download cache.
STREMIOSRV_CACHE_SIZE=10GB
STREMIOSRV_BT_INTERFACE=stremio-test
STREMIOSRV_WIREGUARD_HOST_PATH=/root/stremio.conf

# Enable the authenticated Library UI at /library/.
STREMIOSRV_LIBRARY_UI=true

# Stop seeding automatically when the requested download is complete.
STREMIOSRV_SEED_ON_COMPLETE=false

# Optional: public origin used by the bundled Stremio web player.
SERVER_URL=https://stremio.example.com

# Optional: only needed for the automatic *.stremio.rocks certificate path.
# IPADDRESS=

# Coolify/cloud deployment: do not rely on UPnP/NAT-PMP.
STREMIOSRV_ENABLE_UPNP=false
